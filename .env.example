# ─── L1: CoinMarketCap Agent Hub ───────────────────────────────────────────
CMC_API_KEY=
CMC_MCP_ENDPOINT=

# ─── L2: Trust Wallet Agent Kit (TWAK) ─────────────────────────────────────
TW_ACCESS_ID=
TW_HMAC_SECRET=
# Override the TWAK API base URL (default in core/config/constants.py TWAK_API_BASE_DEFAULT)
TWAK_API_BASE=

# ─── L3: BNB AI Agent SDK ──────────────────────────────────────────────────
# No API key — SDK uses a local encrypted keystore.
# First run: set PRIVATE_KEY to seed the keystore, then delete this line.
# Every run: WALLET_PASSWORD decrypts the stored keystore.
WALLET_PASSWORD=
PRIVATE_KEY=
# Optional RPC overrides (constants.py has the defaults)
BNB_RPC_URL=
BNB_TESTNET_RPC_URL=

# ─── Upstash ───────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ─── Convex ────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# ─── Trigger.dev ───────────────────────────────────────────────────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ─── LLM (Claude) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Runtime ───────────────────────────────────────────────────────────────
# "testnet" | "paper" | "mainnet"
TRADING_MODE=testnet
# Comma-separated token allowlist e.g. BNB,WBNB,USDT,BTCB,ETH
TOKEN_ALLOWLIST=BNB,WBNB,USDT
