# ─── L1: CoinMarketCap Agent Hub ───────────────────────────────────────────
CMC_API_KEY=
CMC_MCP_ENDPOINT=

# ─── L2: Trust Wallet Agent Kit (TWAK) ─────────────────────────────────────
# From TWAK dashboard — no separate wallet address, wallet is managed via access credentials
TW_ACCESS_ID=
TW_HMAC_SECRET=
# x402 pay-per-call shared secret (CMC + TWAK)
X402_SECRET=

# ─── L3: BNB AI Agent SDK ──────────────────────────────────────────────────
BNB_SDK_API_KEY=
BNB_RPC_URL=https://bsc-dataseed.binance.org/
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BNB_CHAIN_ID=56
BNB_TESTNET_CHAIN_ID=97

# ─── Upstash ───────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ─── Convex ────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# ─── Trigger.dev ───────────────────────────────────────────────────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev

# ─── LLM (Claude) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Runtime ───────────────────────────────────────────────────────────────
# "testnet" | "paper" | "mainnet"
TRADING_MODE=testnet
# Comma-separated token allowlist e.g. BNB,WBNB,USDT,BTCB,ETH
TOKEN_ALLOWLIST=BNB,WBNB,USDT
