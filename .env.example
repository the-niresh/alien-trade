# ─── L1: CoinMarketCap Agent Hub ───────────────────────────────────────────
CMC_API_KEY=
CMC_MCP_ENDPOINT=
# MCP Skill Hub key - used by .mcp.json and Phase 6 LangGraph research agent
CMC_MCP_API_KEY=

# ─── x402 micropayments ─────────────────────────────────────────────────────
# x402 is a pay-per-call HTTP payment protocol (coinbase/x402).
# CMC Agent Hub calls are made via x402 when this key is set.
# Use a DEDICATED micropayment wallet - NOT the trading wallet.
# Fund it with a small amount of USDC on Base (eip155:8453), ~$5-10 covers
# hundreds of API calls at typical CMC micropayment rates.
# Leave blank to fall back to plain CMC_API_KEY auth.
X402_PRIVATE_KEY=
# EVM network for x402 payments (default: eip155:8453 = Base mainnet).
# Override here only if CMC specifies a different network.
X402_NETWORK=eip155:8453

# ─── L2: Trust Wallet Agent Kit (TWAK) ─────────────────────────────────────
# Python REST client (core/exec/twak.py) reads these:
TW_ACCESS_ID=
TW_HMAC_SECRET=
# The `twak` CLI reads its OWN env names (or persisted ~/.twak/credentials.json):
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
# Override the TWAK API base URL (default in core/config/constants.py TWAK_API_BASE_DEFAULT)
TWAK_API_BASE=
# Wallet password for the twak CLI (or store it in the OS keychain; never commit it)
TWAK_WALLET_PASSWORD=

# ─── L3: BNB AI Agent SDK ──────────────────────────────────────────────────
# No API key - SDK uses a local encrypted keystore.
# First run: set PRIVATE_KEY to seed the keystore, then delete this line.
# Every run: WALLET_PASSWORD decrypts the stored keystore.
WALLET_PASSWORD=
PRIVATE_KEY=
# Optional RPC overrides (constants.py has the defaults)
BNB_RPC_URL=
BNB_TESTNET_RPC_URL=
# Public wallet address the agent trades from (keys stay in TWAK, never here).
# Required only for testnet/mainnet execution.
WALLET_ADDRESS=

# ─── Upstash ───────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ─── Convex ────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# ─── Trigger.dev ───────────────────────────────────────────────────────────
TRIGGER_API_KEY=
TRIGGER_API_URL=https://api.trigger.dev
# Project ref from the Trigger.dev dashboard (proj_...) - used by jobs/trigger.config.ts
TRIGGER_PROJECT_REF=
# Where the Trigger.dev jobs reach the live agent's FastAPI runtime
AGENT_URL=http://localhost:8000

# ─── Social ingestion layer (agent/social) ─────────────────────────────────
# RSS + Farcaster need NO credentials - they work out of the box.
# Telegram (Telethon) - free api_id/api_hash from https://my.telegram.org.
# Generate a StringSession once (interactive login) and paste it here.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# X / Twitter (twscrape) - OPTIONAL, ToS-risk, use a BURNER X account.
#   uv pip install --python core/.venv/Scripts/python.exe twscrape
#   then add+login a burner account into twscrape's db, and set:
X_ACCOUNTS_READY=
TWSCRAPE_DB=
# Path to the watchlist JSON (defaults to agent/social/watchlist.example.json)
SOCIAL_WATCHLIST=

# ─── Event Intelligence (Brave Search news) ────────────────────────────────
# Free tier key from https://api.search.brave.com/ - powers the real-time
# news/event layer (risk-off on hacks/depegs/regulatory, sentiment nudge).
# Absent -> the intel layer is a quiet no-op (offline-first).
BRAVE_API_KEY=
# Optional override; defaults to https://api.search.brave.com
BRAVE_BASE_URL=

# ─── LLM (Claude primary) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional OpenAI fallback - used ONLY when the Anthropic API is unreachable, so
# the off-hot-path LLM layers (reflection/research/co-pilot) never go dark.
OPENAI_API_KEY=
# Optional override for the fallback model (default: gpt-4o-mini).
OPENAI_FALLBACK_MODEL=

# ─── Runtime ───────────────────────────────────────────────────────────────
# "testnet" | "paper" | "mainnet"
TRADING_MODE=testnet
# Live execution backend: "twak" (self-custody CLI, mainnet) | "raw" (BNB SDK + key)
EXECUTION_BACKEND=twak
# Comma-separated token allowlist e.g. BNB,WBNB,USDT,BTCB,ETH
TOKEN_ALLOWLIST=BNB,WBNB,USDT
# Hosted PWA dashboard URL - rendered as a scannable terminal QR on startup
PWA_URL=

# ─── Agent FastAPI auth ─────────────────────────────────────────────────────
# Shared secret required on every non-public agent API route (copilot, twak/*,
# supervisor, dreamer, telemetry, skill/*). Callers send it as the X-API-Token
# header. Leave blank ONLY in local/paper dev - the server also binds to
# 127.0.0.1 (see alien-api.service), so the port is not exposed externally.
# On mainnet, set this AND keep the localhost bind. Generate: openssl rand -hex 24
AGENT_API_TOKEN=

# Shared-secret gate for state-changing Convex control mutations (kill switch,
# strategy, limits, command queue). Must ALSO be set in the Convex deployment env
# (bunx convex env set CONTROL_TOKEN ...). Generate: openssl rand -hex 24
CONTROL_TOKEN=
